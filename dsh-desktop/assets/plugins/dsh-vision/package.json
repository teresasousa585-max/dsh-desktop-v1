{
  "name": "@dsh-external/dsh-vision",
  "version": "0.2.0",
  "description": "DSH Desktop 内置识图插件：只为纯文本模型提供 view_image；当前模型原生支持 image 时自动停用，通过任意 OpenAI 兼容 VLM 端点回答图片问题。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh.plugin.json"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dshx": {
    "contributes": {
      "tools": [
        "view_image"
      ],
      "skills": []
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-settings": "*",
    "react": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
